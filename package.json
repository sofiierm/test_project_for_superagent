{
  "name": "creator-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Веб-сервис аналитики контента креаторов: Instagram, YouTube, TikTok",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning scripts/serve.mjs",
    "serve": "node --disable-warning=ExperimentalWarning scripts/serve.mjs",
    "start": "node --disable-warning=ExperimentalWarning scripts/serve.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/unit/*.test.mjs\" \"tests/api/*.test.mjs\"",
    "test:e2e": "node scripts/check-layout.mjs && node tests/e2e.mjs",
    "test:all": "npm test && npm run test:e2e",
    "demo:seed": "node --disable-warning=ExperimentalWarning scripts/seed-demo.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
