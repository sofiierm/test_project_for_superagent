# Переменные окружения. Скопируйте в .env и поправьте под себя:
#   cp .env.example .env
# Значения по умолчанию подходят для локального запуска «из коробки».

# Порт и адрес сервера
PORT=4180
HOST=127.0.0.1

# Каталог с базой SQLite. В git не попадает.
DATA_DIR=data

# Часовой пояс для расчёта «лучшего времени публикации»
APP_TIME_ZONE=Europe/Moscow

# Наполнять ли базу демо-аккаунтами при первом запуске на пустой базе
SEED_DEMO=true

# Сколько последних роликов забирать при синхронизации одного аккаунта
SYNC_LIMIT=24

# Источник данных: auto | demo | ytdlp
#   auto  — yt-dlp, если он найден, иначе демо-данные
#   demo  — только сгенерированные данные, сеть не нужна
#   ytdlp — только реальные публичные данные через yt-dlp
PROVIDER=auto

# Путь к yt-dlp. По умолчанию ищется в PATH.
YTDLP_PATH=yt-dlp

# Таймаут одного сетевого запроса к платформе, мс
PROVIDER_TIMEOUT_MS=60000

# Фоновая синхронизация: сервис сам обновляет метрики по расписанию.
# Отключить можно SYNC_SCHEDULER=false — тогда метрики обновляются только
# кнопкой «Синхронизировать».
SYNC_SCHEDULER=true

# Базовый интервал между синхронизациями одного аккаунта, минуты.
# Минимум — 15: чаще платформу дёргать вредно.
SYNC_INTERVAL_MINUTES=180

# Как часто планировщик проверяет, кому пора синхронизироваться, мс
SYNC_TICK_MS=60000

# Пауза после ошибки источника, минуты: 15, 30, 60, 120… до потолка.
# Для bot_check и rate_limited база вчетверо больше, чтобы не усугублять блокировку.
SYNC_BACKOFF_MINUTES=15
SYNC_BACKOFF_MAX_MINUTES=720

# ---- Доступ (#7) ----
# Локальный запуск одного человека: вход не нужен, все действия — от владельца.
# Для общего доступа по сети поставьте true и задайте SESSION_SECRET.
AUTH_REQUIRED=false

# Секрет подписи cookie сессии. Обязателен при AUTH_REQUIRED=true, минимум 16
# символов. Сгенерировать: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Храните в секрете: зная его, можно подделать сессию любого пользователя.
SESSION_SECRET=

# Secure-флаг cookie. Включайте за HTTPS (в проде — да), на http://localhost
# оставьте false: иначе браузер не сохранит cookie и вход не сработает.
COOKIE_SECURE=false

# ---- Семантический анализ (#11) ----
# none (по умолчанию) — словарный анализ, без сети;
# local — локальный эмбеддинг на основах слов, без сети и без модели;
# remote — внешний сервис эмбеддингов. Текст роликов покидает сервер.
EMBEDDING_PROVIDER=none

# Адрес сервиса эмбеддингов для EMBEDDING_PROVIDER=remote.
# Ожидается POST {"input": ["текст", ...]} → {"embeddings": [[...], ...]}.
EMBEDDING_ENDPOINT=

# Таймаут запроса к сервису эмбеддингов, мс
EMBEDDING_TIMEOUT_MS=15000

# ---- Официальные API платформ (#8) ----
# Ключ YouTube Data API v3. Без него PROVIDER=official работает только как
# явная ошибка в интерфейсе: сервис не притворяется, что данные официальные.
YOUTUBE_API_KEY=

# Ключ шифрования токенов платформ (AES-256-GCM). Если не задан, выводится из
# SESSION_SECRET. Отдельная переменная удобнее: смена пароля сессий не делает
# сохранённые токены нечитаемыми.
TOKEN_SECRET=
