# Переменные окружения. Скопируйте в .env и поправьте под себя:
#   cp .env.example .env
# Значения по умолчанию подходят для локального запуска «из коробки».

# Порт и адрес сервера
PORT=4180
HOST=127.0.0.1

# Каталог с базой SQLite. В git не попадает.
DATA_DIR=data

# Часовой пояс для расчёта «лучшего времени публикации»
APP_TIME_ZONE=Europe/Moscow

# Наполнять ли базу демо-аккаунтами при первом запуске на пустой базе
SEED_DEMO=true

# Сколько последних роликов забирать при синхронизации одного аккаунта
SYNC_LIMIT=24

# Источник данных: auto | demo | ytdlp
#   auto  — yt-dlp, если он найден, иначе демо-данные
#   demo  — только сгенерированные данные, сеть не нужна
#   ytdlp — только реальные публичные данные через yt-dlp
PROVIDER=auto

# Путь к yt-dlp. По умолчанию ищется в PATH.
YTDLP_PATH=yt-dlp

# Таймаут одного сетевого запроса к платформе, мс
PROVIDER_TIMEOUT_MS=60000

# Фоновая синхронизация: сервис сам обновляет метрики по расписанию.
# Отключить можно SYNC_SCHEDULER=false — тогда метрики обновляются только
# кнопкой «Синхронизировать».
SYNC_SCHEDULER=true

# Базовый интервал между синхронизациями одного аккаунта, минуты.
# Минимум — 15: чаще платформу дёргать вредно.
SYNC_INTERVAL_MINUTES=180

# Как часто планировщик проверяет, кому пора синхронизироваться, мс
SYNC_TICK_MS=60000

# Пауза после ошибки источника, минуты: 15, 30, 60, 120… до потолка.
# Для bot_check и rate_limited база вчетверо больше, чтобы не усугублять блокировку.
SYNC_BACKOFF_MINUTES=15
SYNC_BACKOFF_MAX_MINUTES=720
